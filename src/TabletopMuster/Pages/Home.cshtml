@page
@model TabletopMuster.Pages.HomeModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = Model.SelectedSystem.Name;
    Layout = "_AppLayout";

    // System categories first (in their order), then any category the system doesn't list.
    var categories = Model.SelectedSystem.Categories
        .Concat(Model.Units.Select(u => u.Category))
        .Distinct()
        .ToList();
    var hasCustomUnits = Model.Units.Any(u => u.IsCustom);
    var hasImported = Model.ArmyLists.Any(l => l.IsImported);
    var catalogueJson = JsonSerializer.Serialize(
        new { stats = Model.SelectedSystem.Stats, units = Model.Units },
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="page-head">
    <div>
        <p class="eyebrow">@(Model.SelectedSystem.Genre ?? "Game system")</p>
        <h1 class="page-title">@Model.SelectedSystem.Name</h1>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-outline-light" data-bs-toggle="modal" data-bs-target="#importModal">Import list</button>
        <a class="btn btn-accent" asp-page="/ArmyLists/Edit" asp-route-system="@Model.SystemId">New army list</a>
    </div>
</div>

<ul class="nav app-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="lists-tab" data-bs-toggle="tab" data-bs-target="#lists-pane" type="button"
                role="tab" aria-controls="lists-pane" aria-selected="true">
            Army lists <span class="tab-count">@Model.ArmyLists.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="catalogue-tab" data-bs-toggle="tab" data-bs-target="#catalogue-pane" type="button"
                role="tab" aria-controls="catalogue-pane" aria-selected="false">
            Unit catalogue <span class="tab-count">@Model.Units.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    @* ---------------- Army lists ---------------- *@
    <section class="tab-pane fade show active" id="lists-pane" role="tabpanel" aria-labelledby="lists-tab" tabindex="0" data-filter-scope>
        @if (Model.ArmyLists.Count == 0)
        {
            <div class="empty-state">
                <h2 class="h5">No army lists in @Model.SelectedSystem.Name yet</h2>
                <p>Build your first list, or import one you already have.</p>
                <a class="btn btn-accent" asp-page="/ArmyLists/Edit" asp-route-system="@Model.SystemId">New army list</a>
            </div>
        }
        else
        {
            <div class="filter-bar">
                <input type="search" class="form-control" placeholder="Search army lists" aria-label="Search army lists" data-filter="search" />
                <select class="form-select" aria-label="Faction" data-filter="faction">
                    <option value="">All factions</option>
                    @foreach (var f in Model.Factions)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
                <select class="form-select" aria-label="Source" data-filter="source">
                    <option value="">Created and imported</option>
                    <option value="mine">Created by me</option>
                    <option value="imported" disabled="@(!hasImported)">Imported</option>
                </select>
                <select class="form-select" aria-label="Sort by" data-sort>
                    <option value="updated">Recently edited</option>
                    <option value="name">Name A–Z</option>
                    <option value="points-desc">Points: high to low</option>
                    <option value="points-asc">Points: low to high</option>
                </select>
            </div>

            <div class="list-grid" data-sort-container>
                @foreach (var l in Model.ArmyLists)
                {
                    var over = l.PointsTotal > l.PointsLimit;
                    var pct = l.PointsLimit > 0 ? Math.Min(100, l.PointsTotal * 100 / l.PointsLimit) : 0;
                    <article class="list-card @(over ? "is-over" : "")" data-item data-name="@l.Name.ToLowerInvariant()"
                             data-faction="@l.FactionId" data-source="@(l.IsImported ? "imported" : "mine")"
                             data-points="@l.PointsTotal" data-updated="@l.UpdatedAt.ToString("o", CultureInfo.InvariantCulture)">
                        <div class="list-card-head">
                            <div class="min-w-0">
                                <h2 class="list-card-title">
                                    <a asp-page="/ArmyLists/Edit" asp-route-id="@l.Id" asp-route-system="@Model.SystemId">@l.Name</a>
                                </h2>
                                <p class="list-card-meta">@l.FactionName · @l.UnitCount @(l.UnitCount == 1 ? "unit" : "units")</p>
                            </div>
                            @if (l.IsImported)
                            {
                                <span class="badge tag-imported">Imported</span>
                            }
                        </div>

                        <div class="points-meter">
                            <div class="points-meter-text">
                                <span><strong>@l.PointsTotal</strong> / @l.PointsLimit pts</span>
                                @if (over)
                                {
                                    <span class="over-text">@(l.PointsTotal - l.PointsLimit) over the limit</span>
                                }
                                else
                                {
                                    <span class="text-muted-app">@(l.PointsLimit - l.PointsTotal) left</span>
                                }
                            </div>
                            <div class="progress" role="progressbar" aria-label="Points used" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: @pct%"></div>
                            </div>
                        </div>

                        <div class="list-card-foot">
                            <span class="text-muted-app small">Edited @l.UpdatedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-outline-light" asp-page="/ArmyLists/Edit" asp-route-id="@l.Id" asp-route-system="@Model.SystemId">Edit</a>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-list-id="@l.Id" data-list-name="@l.Name">Delete</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
            <p class="no-results d-none" data-no-results>No army lists match these filters.</p>
        }
    </section>

    @* ---------------- Unit catalogue ---------------- *@
    <section class="tab-pane fade" id="catalogue-pane" role="tabpanel" aria-labelledby="catalogue-tab" tabindex="0" data-filter-scope>
        @if (Model.Units.Count == 0)
        {
            <div class="empty-state">
                <h2 class="h5">No units in @Model.SelectedSystem.Name yet</h2>
                <p>The catalogue for this system is empty.</p>
            </div>
        }
        else
        {
            <div class="filter-bar">
                <input type="search" class="form-control" placeholder="Search units" aria-label="Search units" data-filter="search" />
                <select class="form-select" aria-label="Faction" data-filter="faction">
                    <option value="">All factions</option>
                    @foreach (var f in Model.Factions)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </select>
                <select class="form-select" aria-label="Source" data-filter="source">
                    <option value="">Official and custom</option>
                    <option value="official">Official only</option>
                    <option value="custom" disabled="@(!hasCustomUnits)">Custom only</option>
                </select>
                <select class="form-select" aria-label="Sort by" data-sort>
                    <option value="name">Name A–Z</option>
                    <option value="points-asc">Points: low to high</option>
                    <option value="points-desc">Points: high to low</option>
                </select>
            </div>

            <div class="chip-row" role="group" aria-label="Category">
                <button type="button" class="chip active" data-category-chip="" aria-pressed="true">All</button>
                @foreach (var c in categories)
                {
                    <button type="button" class="chip" data-category-chip="@c" aria-pressed="false">@c</button>
                }
            </div>

            @foreach (var c in categories)
            {
                var units = Model.Units.Where(u => u.Category == c).OrderBy(u => u.Name).ToList();
                if (units.Count == 0)
                {
                    continue;
                }
                <section class="unit-group" data-group aria-label="@c">
                    <h2 class="group-title">@c <span class="group-count" data-group-count>@units.Count</span></h2>
                    <div class="unit-grid" data-sort-container>
                        @foreach (var u in units)
                        {
                            <partial name="_UnitCard" model="new UnitCardVm(u, false)" />
                        }
                    </div>
                </section>
            }
            <p class="no-results d-none" data-no-results>No units match these filters.</p>
        }
    </section>
</div>

@* ---------------- Unit details popup (filled in by home.js) ---------------- *@
<div class="modal fade" id="unitModal" tabindex="-1" aria-labelledby="unitModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="min-w-0">
                    <p class="eyebrow mb-1" data-u-meta></p>
                    <h2 class="modal-title h4" id="unitModalTitle" data-u-name></h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="unit-art unit-art-lg" data-u-art></div>
                        <p class="unit-modal-points"><span data-u-points></span> pts</p>
                        <p class="small text-muted-app mb-0 d-none" data-u-author></p>
                    </div>
                    <div class="col-md-7">
                        <h3 class="modal-section-title">Stats</h3>
                        <div class="stat-table-wrap">
                            <table class="stat-table" data-u-stats>
                                <thead><tr></tr></thead>
                                <tbody><tr></tr></tbody>
                            </table>
                        </div>
                        <h3 class="modal-section-title">Rules</h3>
                        <p class="rules-text" data-u-rules></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------------- Import popup ---------------- *@
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Import" asp-route-system="@Model.SystemId" enctype="multipart/form-data">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="importModalTitle">Import an army list</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted-app small">The list is added to <strong>@Model.SelectedSystem.Name</strong> and marked as imported.</p>
                    <label asp-for="ImportFile" class="form-label">Choose a file</label>
                    <input asp-for="ImportFile" type="file" class="form-control" accept=".json,.txt" />
                    <div class="or-divider"><span>or paste it</span></div>
                    <label asp-for="ImportText" class="visually-hidden">List text</label>
                    <textarea asp-for="ImportText" class="form-control" rows="5" placeholder="Paste an exported army list here"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ---------------- Delete confirmation ---------------- *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete" asp-route-system="@Model.SystemId">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="deleteModalTitle">Delete army list?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0"><strong data-delete-name></strong> will be deleted. This can't be undone.</p>
                    <input type="hidden" name="id" data-delete-id />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="application/json" id="catalogue-data">@Html.Raw(catalogueJson)</script>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
